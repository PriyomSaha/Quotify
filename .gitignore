# ============================================================================
# FONTS - Exclude all except Montserrat-Light.ttf and OFL.txt
# ============================================================================
# Ignore entire Montserrat directory
Montserrat/*

# But keep license file only
!Montserrat/OFL.txt

# Keep the static folder structure
!Montserrat/static/

# Ignore everything in static folder
Montserrat/static/*

# But keep only the one font we use
!Montserrat/static/Montserrat-Light.ttf

